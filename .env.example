# ── Server ────────────────────────────────────────────────────────────────
# Development: the API listens on API_PORT (default 4000) and Vite proxies /api to it from :5173.
# Production (npm start): one process serves API + built client on PORT (default 4000).
API_PORT=4000
PORT=4000
NODE_ENV=development

# Secret used to sign session cookies. REQUIRED in production.
# In development, if left empty, a random secret is generated once and stored in data/.session_secret
JWT_SECRET=

# SQLite database file (created automatically, seeded on first launch)
DATABASE_PATH=./data/aftrhrs.db

# ── Mood AI ───────────────────────────────────────────────────────────────
# Leave AI_PROVIDER empty to use the built-in rule-based engine (default, free, no network).
# Set to "openai" or "gemini" together with AI_API_KEY to let an LLM voice the replies.
# Keys are only ever read on the server — never exposed to the browser.
AI_PROVIDER=
AI_API_KEY=
AI_MODEL=

# ── Music metadata ────────────────────────────────────────────────────────
# "itunes" (default): looks up official artwork + 30-second previews through Apple's public
#   iTunes Search API, in the background, and caches the result. No key required.
# "off": no network calls. Generated cover art and outbound links only.
MUSIC_METADATA=itunes
